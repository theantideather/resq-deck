# Copy to .env and fill in what you use. Never commit .env.

# Claude strategist, trade review lessons
ANTHROPIC_API_KEY=
# AURUM_MODEL=claude-opus-5

# TradingView webhook shared secret (required if the dashboard is reachable from the internet)
AURUM_WEBHOOK_TOKEN=
# Set to "paper" to let TradingView alerts trade the paper account
AURUM_WEBHOOK_EXECUTE=

# OANDA v20 (practice first)
OANDA_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# MetaTrader 5 (Windows host only; not usable inside this Linux container)
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
# MT5_SYMBOL=XAUUSD
# MT5_SERVER_UTC_OFFSET=2

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AURUM_NOTIFY_WEBHOOK=

# Extra data: your own daily series and event calendar
# AURUM_EXTRA_SERIES=cb_buying=/data/cb_gold.csv@30D;gld_tonnes=/data/gld.csv@1D
# AURUM_EVENTS_CSV=/data/events.csv
# AURUM_NEWS_FEEDS=https://www.federalreserve.gov/feeds/press_all.xml

# Real money: both --allow-live on the runner AND this exact sentence
# AURUM_LIVE_ACK=I accept the risk of trading real money
