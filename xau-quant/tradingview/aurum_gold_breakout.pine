//@version=6
indicator("aurum · Gold Breakout", shorttitle = "aurum breakout", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// Rules (daily XAUUSD, tested 2017-2026 on real data with costs and swap):
//   Uptrend   = close above EMA 200 and EMA 50 above EMA 200 (downtrend is the mirror).
//   Buy       = in an uptrend, the daily close breaks the highest high of the previous 50 days.
//   Sell      = in a downtrend, the close breaks the lowest low of the previous 50 days.
//   Stop      = 2.5 ATR(14) from entry, then trails 3 ATR behind the best price since entry.
//   Target    = 5R (5 x the starting stop distance).
//   One trade at a time; entries at the daily close, stop and target checked on later bars.
// At 1% risk per trade: 32 trades, 69% winners, profit factor 5.2, +25R, max drawdown 4.3%.
// Research software. Not investment advice.

lookback  = input.int(50, "Breakout lookback (days)", minval = 5)
fastLen   = input.int(50, "Trend EMA fast", minval = 5)
slowLen   = input.int(200, "Trend EMA slow", minval = 20)
stopAtr   = input.float(2.5, "Starting stop (ATR)", step = 0.25)
trailAtr  = input.float(3.0, "Trailing stop (ATR)", step = 0.25)
targetR   = input.float(5.0, "Target (R, 0 = none)", step = 0.5)
allowShort = input.bool(true, "Take sell signals")
riskPct   = input.float(1.0, "Risk per trade (%)", step = 0.25)
account   = input.float(10000, "Account size", step = 1000)
showBoxes = input.bool(true, "Draw stop / target boxes")

// ─── Trend, breakout levels and signals ─────────────────────────────────────
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
atr     = ta.atr(14)
upper   = ta.highest(high, lookback)[1]
lower   = ta.lowest(low, lookback)[1]
upTrend = close > emaSlow and emaFast > emaSlow
dnTrend = close < emaSlow and emaFast < emaSlow
buySig  = upTrend and close > upper
sellSig = allowShort and dnTrend and close < lower

// ─── One simulated trade at a time ──────────────────────────────────────────
var int   pos      = 0
var float entry    = na
var float stopPx   = na
var float targetPx = na
var float risk0    = na
var float best     = na
var float qty      = na
var int   entryBar = na
var box   slBox    = na
var box   tpBox    = na
var int   nTrades  = 0
var int   nWins    = 0
var float sumWinR  = 0.0
var float sumLossR = 0.0

exitPx = float(na)

// 1. Stop or target hit during this bar (stop is checked first).
if pos != 0
    hitStop = pos == 1 ? low <= stopPx : high >= stopPx
    hitTgt  = not na(targetPx) and (pos == 1 ? high >= targetPx : low <= targetPx)
    if hitStop
        gap = pos == 1 ? open < stopPx : open > stopPx
        exitPx := gap ? open : stopPx
    else if hitTgt
        exitPx := targetPx
    if not na(exitPx)
        r = pos * (exitPx - entry) / risk0
        nTrades += 1
        if r > 0
            nWins += 1
            sumWinR += r
        else
            sumLossR -= r
        label.new(bar_index, exitPx, (hitStop ? "Stop " : "Target ") + str.tostring(r, "#.##") + "R",
             style = pos == 1 ? label.style_label_down : label.style_label_up,
             color = r > 0 ? color.new(#089981, 0) : color.new(#f23645, 0), textcolor = color.white, size = size.tiny)
        if showBoxes and not na(slBox)
            box.set_right(slBox, bar_index)
            box.set_right(tpBox, bar_index)
        pos := 0
        alert("aurum breakout: exit " + (hitStop ? "stop" : "target") + " at " + str.tostring(exitPx, format.mintick), alert.freq_once_per_bar_close)

// 2. New entry at the close.
if pos == 0 and (buySig or sellSig) and not na(atr)
    pos      := buySig ? 1 : -1
    entry    := close
    risk0    := stopAtr * atr
    stopPx   := close - pos * risk0
    targetPx := targetR > 0 ? close + pos * targetR * risk0 : na
    best     := pos == 1 ? high : low
    qty      := account * riskPct / 100 / risk0
    entryBar := bar_index
    tgtShown = na(targetPx) ? close + pos * 3 * risk0 : targetPx
    if showBoxes
        slBox := box.new(bar_index, math.max(entry, stopPx), bar_index + 1, math.min(entry, stopPx),
             border_color = color.new(#f23645, 60), bgcolor = color.new(#f23645, 80))
        tpBox := box.new(bar_index, math.max(entry, tgtShown), bar_index + 1, math.min(entry, tgtShown),
             border_color = color.new(#089981, 60), bgcolor = color.new(#089981, 80))
    txt = (pos == 1 ? "BUY " : "SELL ") + str.tostring(entry, format.mintick) +
         "\nSL " + str.tostring(stopPx, format.mintick) +
         "\nTP " + (na(targetPx) ? "trail" : str.tostring(targetPx, format.mintick)) +
         "\nQty " + str.tostring(qty, "#.##") + " oz"
    label.new(bar_index, pos == 1 ? low : high, txt,
         style = pos == 1 ? label.style_label_up : label.style_label_down,
         color = pos == 1 ? color.new(#089981, 0) : color.new(#f23645, 0), textcolor = color.white, size = size.small)
    alert("aurum breakout: " + (pos == 1 ? "BUY" : "SELL") + " at " + str.tostring(entry, format.mintick) +
         " SL " + str.tostring(stopPx, format.mintick) + " TP " + str.tostring(targetPx, format.mintick), alert.freq_once_per_bar_close)

// 3. Trail the stop for the next bar and stretch the boxes.
if pos != 0
    best := pos == 1 ? math.max(best, high) : math.min(best, low)
    stopPx := pos == 1 ? math.max(stopPx, best - trailAtr * atr) : math.min(stopPx, best + trailAtr * atr)
    if showBoxes and not na(slBox)
        box.set_right(slBox, bar_index + 1)
        box.set_right(tpBox, bar_index + 1)
        box.set_top(slBox, math.max(entry, stopPx))
        box.set_bottom(slBox, math.min(entry, stopPx))

alertcondition(buySig and pos == 1 and entryBar == bar_index, "Buy signal", "aurum breakout: BUY {{ticker}} at {{close}}")
alertcondition(sellSig and pos == -1 and entryBar == bar_index, "Sell signal", "aurum breakout: SELL {{ticker}} at {{close}}")

// ─── Plots ──────────────────────────────────────────────────────────────────
plot(emaSlow, "EMA 200", color = color.new(color.black, 0), linewidth = 2)
plot(emaFast, "EMA 50", color = color.new(color.blue, 0), linewidth = 1)
plot(upper, "50-day high", color = color.new(#089981, 50), style = plot.style_stepline)
plot(lower, "50-day low", color = color.new(#f23645, 50), style = plot.style_stepline)
plot(pos != 0 ? stopPx : na, "Stop", color = color.new(#f23645, 0), style = plot.style_linebr, linewidth = 2)
plot(pos != 0 ? targetPx : na, "Target", color = color.new(#089981, 0), style = plot.style_linebr, linewidth = 2)
plot(pos != 0 ? entry : na, "Entry", color = color.new(color.gray, 0), style = plot.style_linebr)
bgcolor(upTrend ? color.new(#089981, 94) : dnTrend ? color.new(#f23645, 94) : na, title = "Trend")

// ─── Stats table ────────────────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 7, bgcolor = color.white, border_color = color.new(color.gray, 60), border_width = 1)
if barstate.islast
    pf = sumLossR > 0 ? sumWinR / sumLossR : na
    table.cell(t, 0, 0, "aurum breakout", text_color = color.black)
    table.cell(t, 1, 0, "Daily", text_color = color.black)
    table.cell(t, 0, 1, "Trend", text_color = color.black)
    table.cell(t, 1, 1, upTrend ? "Up" : dnTrend ? "Down" : "None", text_color = color.black,
         bgcolor = upTrend ? color.new(#089981, 60) : dnTrend ? color.new(#f23645, 60) : color.new(color.gray, 80))
    table.cell(t, 0, 2, "Position", text_color = color.black)
    table.cell(t, 1, 2, pos == 1 ? "Long" : pos == -1 ? "Short" : "Flat", text_color = color.black)
    table.cell(t, 0, 3, "Trades", text_color = color.black)
    table.cell(t, 1, 3, str.tostring(nTrades), text_color = color.black)
    table.cell(t, 0, 4, "Win rate", text_color = color.black)
    table.cell(t, 1, 4, nTrades > 0 ? str.tostring(100.0 * nWins / nTrades, "#") + "%" : "n/a", text_color = color.black)
    table.cell(t, 0, 5, "Profit factor", text_color = color.black)
    table.cell(t, 1, 5, na(pf) ? "n/a" : str.tostring(pf, "#.##"), text_color = color.black)
    table.cell(t, 0, 6, "Total R", text_color = color.black)
    table.cell(t, 1, 6, str.tostring(sumWinR - sumLossR, "#.#"), text_color = color.black)
