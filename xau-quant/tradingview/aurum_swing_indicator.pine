// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// aurum · Swing Desk — a rebuild of a BTC swing trader's chart, set up for XAUUSD.
//
// What the original chart shows and how it maps here:
//   stepped trailing line + ribbon + ▲/▼ flip labels  ->  flip engine (HalfTrend by default;
//                                                        amplitude 5 matched 7 of 10 of his BTC
//                                                        markers within 3 days; Supertrend,
//                                                        Chandelier Exit and UT Bot selectable)
//   slow black average                                 ->  EMA 200 regime line
//   thin blue / purple lines near price                ->  EMA 20 / EMA 50
//   Time Frame | Signal table, Aligned, Long/Short WR  ->  multi timeframe table, win rates of
//                                                        this strategy's own closed trades
//   "D CANDLE PO3" box with Range                      ->  current higher timeframe candle drawn
//                                                        to the right of price
//   position tool: stop 4.06%, target 7.15R            ->  stop mode "Swing + 0.5 ATR, 7R target":
//                                                        stop beyond the 10 bar swing high/low plus
//                                                        0.5 ATR (his BTC short of 28 Oct 2025: 10 day
//                                                        high 116,381 + 0.46 ATR = his 118,028 stop),
//                                                        target 7R; every trade is drawn as a
//                                                        position tool box with the same labels
//
// On XAUUSD 1D, 2016 to 2026 (aurum backtester, real data), HalfTrend 5 with the EMA 200 filter:
//   "4% stop, 7R target"          33 trades, profit factor 2.7, max DD 5.6%  (best on gold)
//   "Swing + 0.5 ATR, 7R target"  33 trades, profit factor 1.9, max DD 10.6%
// at 1% risk per trade. TradingView does not charge swap; budget for it on gold longs.
//
// Look: HalfTrend ATR channel as the thick ribbon (red above price in downtrends, mint below
// in uptrends), ▲/▼ squares on the ribbon's outer edge, the open trade's stop as a thin stepped
// line, and a position tool box per trade with Stop / Open PnL / Target labels on the latest one.
// Trade count check on BTC 1D: HalfTrend 5 + EMA 200 filter from April 2025 gives 4 longs and
// 5 shorts, his table's counts. Win rates differ (his 75% / 0%) because his exit rule isn't known.
//
// Indicator version of aurum_swing.pine: same chart, no Strategy Tester. Trades are simulated
// inside the script (stop and target checked on bar highs and lows, stop first when both are
// touched) to draw the position boxes and the Long/Short WR rows, like the original chart.
// Alerts: add an alert on this indicator with "alert() function calls only", or use the
// "Long signal" / "Short signal" conditions; webhook to the aurum dashboard.
// Research software. Not investment advice.

//@version=6
indicator("aurum · Swing Desk (indicator)", shorttitle = "aurum swing", overlay = true, max_bars_back = 5000,
     max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ─── Inputs ────────────────────────────────────────────────────────────────
grpE = "Flip engine"
engineName = input.string("HalfTrend", "Engine", options = ["HalfTrend", "Supertrend", "Chandelier", "UT Bot"], group = grpE, display = display.none)
htAmp      = input.int(5, "HalfTrend amplitude", minval = 1, group = grpE, display = display.none)
htDev      = input.float(2.0, "HalfTrend channel deviation", step = 0.5, group = grpE, display = display.none)
stLen      = input.int(10, "Supertrend ATR length", minval = 1, group = grpE, display = display.none)
stFac      = input.float(3.0, "Supertrend factor", step = 0.1, group = grpE, display = display.none)
ceLen      = input.int(22, "Chandelier length", minval = 1, group = grpE, display = display.none)
ceMult     = input.float(3.0, "Chandelier multiplier", step = 0.1, group = grpE, display = display.none)
utKey      = input.float(1.0, "UT Bot key value", step = 0.1, group = grpE, display = display.none)
utLen      = input.int(10, "UT Bot ATR length", minval = 1, group = grpE, display = display.none)

grpF = "Filters"
useRegime  = input.bool(true, "Regime filter: longs above / shorts below EMA", group = grpF, display = display.none)
regimeLen  = input.int(200, "Regime EMA", minval = 10, group = grpF, display = display.none)
allowLong  = input.bool(true, "Longs", group = grpF, display = display.none)
allowShort = input.bool(true, "Shorts", group = grpF, display = display.none)
mtfMin     = input.int(0, "Min aligned timeframes (0 = off)", minval = 0, maxval = 5, group = grpF, display = display.none)

grpR = "Risk and stops"
stopMode   = input.string("Swing + 0.5 ATR, 7R target", "Stop mode",
     options = ["Swing + 0.5 ATR, 7R target", "4% stop, 7R target", "Trail engine line", "4% stop, breakeven 1R, trail", "2.5 ATR, trail"], group = grpR, display = display.none)
swingLen   = input.int(10, "Swing lookback, bars", minval = 2, group = grpR, display = display.none)
swingBuf   = input.float(0.5, "Swing buffer, ATR", step = 0.05, group = grpR, display = display.none)
showPlan   = input.bool(true, "Draw entry / stop / target boxes", group = grpR, display = display.none)
stopPct    = input.float(4.0, "Fixed stop %", step = 0.25, group = grpR, display = display.none)
targetR    = input.float(7.0, "Target, R multiple", step = 0.5, group = grpR, display = display.none)
beR        = input.float(1.0, "Breakeven after, R", step = 0.25, group = grpR, display = display.none)
riskPct    = input.float(1.0, "Risk per trade, % equity", minval = 0.1, maxval = 5, step = 0.1, group = grpR, display = display.none)
accountUsd = input.float(100000, "Account size for position sizing", minval = 100, group = grpR, display = display.none)
tradeFrom  = input.time(timestamp("01 Apr 2025 00:00 +0000"), "Trades and win rates from", group = grpR, display = display.none)

grpD = "Display"
fastLen    = input.int(20, "Fast EMA", group = grpD, display = display.none)
midLen     = input.int(50, "Mid EMA", group = grpD, display = display.none)
showRibbon = input.bool(true, "ATR channel ribbon", group = grpD, display = display.none)
showTable  = input.bool(true, "Multi timeframe table", group = grpD, display = display.none)
tf1        = input.timeframe("5", "Table TF 1", group = grpD, display = display.none)
tf2        = input.timeframe("15", "Table TF 2", group = grpD, display = display.none)
tf3        = input.timeframe("60", "Table TF 3", group = grpD, display = display.none)
tf4        = input.timeframe("240", "Table TF 4", group = grpD, display = display.none)
tf5        = input.timeframe("D", "Table TF 5", group = grpD, display = display.none)
showPo3    = input.bool(true, "Higher timeframe candle (PO3)", group = grpD, display = display.none)
po3Tf      = input.timeframe("D", "PO3 timeframe", group = grpD, display = display.none)

// ─── Engines: each returns [direction (+1/-1), trailing line] ───────────────
fHalfTrend(int amp, float dev) =>
    var int trend = 0
    var int nextTrend = 0
    var float maxLow = low
    var float minHigh = high
    var float up = na
    var float down = na
    atr2 = ta.atr(100) / 2
    highPrice = ta.highest(high, amp)
    lowPrice = ta.lowest(low, amp)
    highMa = ta.sma(high, amp)
    lowMa = ta.sma(low, amp)
    prevTrend = trend
    if nextTrend == 1
        maxLow := math.max(nz(lowPrice, low), nz(maxLow, low))
        if highMa < maxLow and close < nz(low[1], low)
            trend := 1
            nextTrend := 0
            minHigh := nz(highPrice, high)
    else
        minHigh := math.min(nz(highPrice, high), nz(minHigh, high))
        if lowMa > minHigh and close > nz(high[1], high)
            trend := 0
            nextTrend := 1
            maxLow := nz(lowPrice, low)
    if trend == 0
        up := prevTrend != 0 ? nz(down, maxLow) : na(up) ? maxLow : math.max(maxLow, up)
    else
        down := prevTrend != 1 ? nz(up, minHigh) : na(down) ? minHigh : math.min(minHigh, down)
    ht = trend == 0 ? up : down
    [trend == 0 ? 1 : -1, ht, dev * atr2]

fSupertrend(float fac, int len) =>
    [st, d] = ta.supertrend(fac, len)
    [d < 0 ? 1 : -1, st]

fChandelier(int len, float mult) =>
    a = mult * ta.atr(len)
    longStop = ta.highest(close, len) - a
    longPrev = nz(longStop[1], longStop)
    longStop := close[1] > longPrev ? math.max(longStop, longPrev) : longStop
    shortStop = ta.lowest(close, len) + a
    shortPrev = nz(shortStop[1], shortStop)
    shortStop := close[1] < shortPrev ? math.min(shortStop, shortPrev) : shortStop
    var int ceD = 1
    ceD := close > shortPrev ? 1 : close < longPrev ? -1 : ceD
    [ceD, ceD == 1 ? longStop : shortStop]

fUtBot(float key, int len) =>
    nLoss = key * ta.atr(len)
    var float ts = na
    prev = nz(ts[1], close)
    ts := close > prev and close[1] > prev ? math.max(prev, close - nLoss) :
          close < prev and close[1] < prev ? math.min(prev, close + nLoss) :
          close > prev ? close - nLoss : close + nLoss
    var int utP = 1
    utP := close[1] < prev and close > prev ? 1 : close[1] > prev and close < prev ? -1 : utP
    [utP, ts]

fEngineDir() =>
    [d1, l1, c1] = fHalfTrend(htAmp, htDev)
    [d2, l2] = fSupertrend(stFac, stLen)
    [d3, l3] = fChandelier(ceLen, ceMult)
    [d4, l4] = fUtBot(utKey, utLen)
    engineName == "HalfTrend" ? d1 : engineName == "Supertrend" ? d2 : engineName == "Chandelier" ? d3 : d4

// ─── Engine on the chart timeframe ──────────────────────────────────────────
[htDir, htLine, htChan] = fHalfTrend(htAmp, htDev)
[stDir, stLine] = fSupertrend(stFac, stLen)
[ceDir, ceLine] = fChandelier(ceLen, ceMult)
[utDir, utLine] = fUtBot(utKey, utLen)
dir  = engineName == "HalfTrend" ? htDir : engineName == "Supertrend" ? stDir : engineName == "Chandelier" ? ceDir : utDir
trail = engineName == "HalfTrend" ? htLine : engineName == "Supertrend" ? stLine : engineName == "Chandelier" ? ceLine : utLine
flipUp = dir == 1 and dir[1] == -1
flipDn = dir == -1 and dir[1] == 1

emaR = ta.ema(close, regimeLen)
emaF = ta.ema(close, fastLen)
emaM = ta.ema(close, midLen)
atr14 = ta.atr(14)

// ─── Multi timeframe table values ───────────────────────────────────────────
m1 = request.security(syminfo.tickerid, tf1, fEngineDir())
m2 = request.security(syminfo.tickerid, tf2, fEngineDir())
m3 = request.security(syminfo.tickerid, tf3, fEngineDir())
m4 = request.security(syminfo.tickerid, tf4, fEngineDir())
m5 = request.security(syminfo.tickerid, tf5, fEngineDir())
upCount = (m1 == 1 ? 1 : 0) + (m2 == 1 ? 1 : 0) + (m3 == 1 ? 1 : 0) + (m4 == 1 ? 1 : 0) + (m5 == 1 ? 1 : 0)
dnCount = 5 - upCount

// ─── Entry rules ────────────────────────────────────────────────────────────
inWindow = time >= tradeFrom
longOk  = inWindow and allowLong and (not useRegime or close > emaR) and (mtfMin == 0 or upCount >= mtfMin)
shortOk = inWindow and allowShort and (not useRegime or close < emaR) and (mtfMin == 0 or dnCount >= mtfMin)

useSwing = stopMode == "Swing + 0.5 ATR, 7R target"
usePct  = stopMode == "4% stop, 7R target" or stopMode == "4% stop, breakeven 1R, trail"
useAtr  = stopMode == "2.5 ATR, trail"
trails  = stopMode != "4% stop, 7R target" and not useSwing
useTgt  = stopMode == "4% stop, 7R target" or useSwing
swingLo = ta.lowest(low, swingLen) - swingBuf * atr14
swingHi = ta.highest(high, swingLen) + swingBuf * atr14
useBe   = stopMode == "4% stop, breakeven 1R, trail"

var float stopPx = na
var float targetPx = na
var float entryRef = na
var float initDist = na
var float bestPx = na

alertJson(string action, int s, float qty) =>
    '{"source":"aurum-swing","symbol":"' + syminfo.tickerid + '","engine":"' + engineName + '","action":"' + action +
     '","side":' + str.tostring(s) + ',"qty":' + str.tostring(qty, "#.####") + ',"price":' + str.tostring(close, "#.##") +
     ',"stop":' + str.tostring(nz(stopPx), "#.##") + ',"target":' + str.tostring(nz(targetPx), "#.##") +
     ',"time":' + str.tostring(time_close) + '}'

enterTrade(int side) =>
    dist = useSwing ? (side == 1 ? close - swingLo : swingHi - close) : usePct ? close * stopPct / 100 : useAtr ? 2.5 * atr14 : math.abs(close - trail)
    dist := dist > 0 ? dist : 2.0 * atr14
    qty = accountUsd * riskPct / 100 / dist
    [dist, qty]

// Simulated position: 1 long, -1 short, 0 flat.
var int pos = 0
var int nLong = 0
var int nLongWin = 0
var int nShort = 0
var int nShortWin = 0
var float entryPx = na
var float qtyOpen = na
var int entryBar = na
recordExit(int side, float entry, float exitPx) =>
    win = side * (exitPx - entry) > 0
    [side == 1 ? 1 : 0, side == 1 and win ? 1 : 0, side == -1 ? 1 : 0, side == -1 and win ? 1 : 0]

// Position tool style drawing of each trade: red stop zone, green target zone, labels.
var box slBox = na
var box tpBox = na
var label slLab = na
var label tpLab = na
var label rrLab = na
drawPlan(int side, float entry, float stp, float tgt, float qty) =>
    tgtLevel = na(tgt) ? entry + side * 3 * math.abs(entry - stp) : tgt
    risk = math.abs(entry - stp)
    reward = math.abs(tgtLevel - entry)
    sl = box.new(bar_index, math.max(entry, stp), bar_index + 1, math.min(entry, stp), border_color = color.new(#ef5350, 70), bgcolor = color.new(#ef5350, 75))
    tp = box.new(bar_index, math.max(entry, tgtLevel), bar_index + 1, math.min(entry, tgtLevel), border_color = color.new(#26a69a, 70), bgcolor = color.new(#26a69a, 72))
    slTxt = "Stop: " + str.tostring(risk, format.mintick) + " (" + str.tostring(100 * risk / entry, "#.###") + "%) " +
         str.tostring(math.round(risk / syminfo.mintick)) + ", Amount: " + str.tostring(qty * risk, "#.##")
    tpTxt = (na(tgt) ? "Target (trailing): " : "Target: ") + str.tostring(reward, format.mintick) + " (" + str.tostring(100 * reward / entry, "#.###") + "%) " +
         str.tostring(math.round(reward / syminfo.mintick)) + ", Amount: " + str.tostring(qty * reward, "#.##")
    sll = label.new(bar_index, stp, slTxt, style = side == 1 ? label.style_label_up : label.style_label_down, color = color.new(#f23645, 0), textcolor = color.white, size = size.small)
    tpl = label.new(bar_index, tgtLevel, tpTxt, style = side == 1 ? label.style_label_down : label.style_label_up, color = color.new(#089981, 0), textcolor = color.white, size = size.small)
    rrl = label.new(bar_index, entry, "Open PnL: 0, Qty: " + str.tostring(qty, "#.####") + "\nRisk/reward ratio: " + str.tostring(reward / risk, "#.##"),
         style = label.style_label_center, color = color.new(#089981, 10), textcolor = color.white, size = size.small)
    [sl, tp, sll, tpl, rrl]

// Stretch the boxes to the current bar and keep the labels centred over them.
updatePlan(float px, string state) =>
    if showPlan and not na(slBox)
        box.set_right(slBox, bar_index)
        box.set_right(tpBox, bar_index)
        box.set_top(slBox, math.max(entryPx, stopPx))
        box.set_bottom(slBox, math.min(entryPx, stopPx))
        midX = math.round((entryBar + bar_index) / 2)
        pnl = pos * (px - entryPx) * qtyOpen
        label.set_x(slLab, midX)
        label.set_x(tpLab, midX)
        label.set_x(rrLab, midX)
        rr = na(targetPx) ? "trailing" : str.tostring(math.abs(targetPx - entryPx) / nz(initDist, 1), "#.##")
        label.set_text(rrLab, state + " PnL: " + str.tostring(pnl, "#.#") + ", Qty: " + str.tostring(qtyOpen, "#.####") + "\nRisk/reward ratio: " + rr)
        label.set_color(rrLab, pnl >= 0 ? color.new(#089981, 10) : color.new(#f23645, 10))

// 1. Stop and target inside this bar for an open trade (stop first if both touched).
if pos != 0 and not na(stopPx)
    hitStop = pos == 1 ? low <= stopPx : high >= stopPx
    hitTgt = not na(targetPx) and (pos == 1 ? high >= targetPx : low <= targetPx)
    if hitStop or hitTgt
        exitPx = hitStop ? ((pos == 1 and open < stopPx) or (pos == -1 and open > stopPx) ? open : stopPx) : targetPx
        [a1, a2, a3, a4] = recordExit(pos, entryPx, exitPx)
        nLong += a1
        nLongWin += a2
        nShort += a3
        nShortWin += a4
        alert(alertJson(hitStop ? "stop" : "target", 0, 0), alert.freq_once_per_bar_close)
        updatePlan(exitPx, "Closed")
        pos := 0

// 2. Opposite flip closes the trade.
if pos != 0 and dir != pos
    [a1, a2, a3, a4] = recordExit(pos, entryPx, close)
    nLong += a1
    nLongWin += a2
    nShort += a3
    nShortWin += a4
    alert(alertJson("close", 0, 0), alert.freq_once_per_bar_close)
    updatePlan(close, "Closed")
    pos := 0

// 3. A fresh flip that passes the filters opens a trade at the close.
if pos == 0 and ((flipUp and longOk) or (flipDn and shortOk))
    side = flipUp ? 1 : -1
    [d, q] = enterTrade(side)
    if q > 0
        pos := side
        entryPx := close
        entryBar := bar_index
        qtyOpen := q
        initDist := d
        bestPx := close
        stopPx := close - side * d
        targetPx := useTgt ? close + side * targetR * d : na
        if showPlan
            // Only the latest trade keeps its labels, like a selected position tool.
            label.delete(slLab)
            label.delete(tpLab)
            label.delete(rrLab)
            [b1, b2, l1, l2, l3] = drawPlan(side, close, stopPx, targetPx, q)
            slBox := b1
            tpBox := b2
            slLab := l1
            tpLab := l2
            rrLab := l3
        alert(alertJson(side == 1 ? "buy" : "sell", side, q), alert.freq_once_per_bar_close)
else if pos != 0 and not na(stopPx)
    // 4. Trailing and breakeven for the next bar, ratcheting only in the trade's favour.
    bestPx := pos == 1 ? math.max(nz(bestPx, high), high) : math.min(nz(bestPx, low), low)
    if trails and not na(trail)
        stopPx := pos == 1 ? math.max(stopPx, trail) : math.min(stopPx, trail)
    if useBe and pos * (bestPx - entryPx) >= beR * nz(initDist)
        stopPx := pos == 1 ? math.max(stopPx, entryPx) : math.min(stopPx, entryPx)
    updatePlan(close, "Open")

alertcondition(flipUp and longOk, "Long signal", "aurum swing: long signal on {{ticker}} at {{close}}")
alertcondition(flipDn and shortOk, "Short signal", "aurum swing: short signal on {{ticker}} at {{close}}")

// ─── Plots ──────────────────────────────────────────────────────────────────
upCol = color.new(#22ab94, 0)
dnCol = color.new(#f23645, 0)
chan = nz(htChan, atr14)
bandEdge = dir == 1 ? trail - chan : trail + chan
lineP = plot(trail, "HalfTrend line", color = dir == 1 ? upCol : dnCol, linewidth = 1)
edgeP = plot(showRibbon ? bandEdge : na, "ATR channel edge", color = color.new(color.white, 100), editable = false)
fill(lineP, edgeP, color = dir == 1 ? color.new(#2ed3a5, 55) : color.new(#f05350, 55), title = "ATR channel ribbon")
plot(emaR, "EMA regime", color = color.black, linewidth = 2)
plot(emaF, "EMA fast", color = color.new(color.blue, 20), linewidth = 1)
plot(emaM, "EMA mid", color = color.new(color.purple, 20), linewidth = 1)
plotshape(flipUp ? trail - chan : na, "Buy flip", style = shape.labelup, location = location.absolute, color = color.new(#22ab94, 0),
     text = "▲", textcolor = color.black, size = size.small)
plotshape(flipDn ? trail + chan : na, "Sell flip", style = shape.labeldown, location = location.absolute, color = color.new(#f4511e, 0),
     text = "▼", textcolor = color.black, size = size.small)
plot(pos != 0 ? stopPx : na, "Active stop", color = pos == 1 ? upCol : dnCol, style = plot.style_steplinebr, linewidth = 1)

// ─── Table: timeframes, alignment, win rates ────────────────────────────────
var table t = table.new(position.top_right, 2, 9, bgcolor = color.new(color.white, 0), border_color = color.new(color.gray, 60), border_width = 1)
tfName(string tf) =>
    tf == "D" ? "1D" : tf == "W" ? "1W" : tf == "M" ? "1M" : tf

sigCell(int r, string tf, int d) =>
    table.cell(t, 0, r, tfName(tf), text_color = color.black)
    table.cell(t, 1, r, d == 1 ? "Bullish" : d == -1 ? "Bearish" : "n/a", text_color = color.black,
         bgcolor = d == 1 ? color.new(#26a69a, 60) : d == -1 ? color.new(#ef5350, 60) : color.new(color.gray, 80))

if showTable and barstate.islast
    longs = nLong
    longWins = nLongWin
    shorts = nShort
    shortWins = nShortWin
    table.cell(t, 0, 0, "Time Frame", text_color = color.black)
    table.cell(t, 1, 0, "Signal", text_color = color.black)
    sigCell(1, tf1, int(m1))
    sigCell(2, tf2, int(m2))
    sigCell(3, tf3, int(m3))
    sigCell(4, tf4, int(m4))
    sigCell(5, tf5, int(m5))
    table.cell(t, 0, 6, "Aligned", text_color = color.black)
    table.cell(t, 1, 6, str.tostring(upCount) + "▲ / " + str.tostring(dnCount) + "▼", text_color = color.black)
    table.cell(t, 0, 7, "Long WR", text_color = color.black)
    table.cell(t, 1, 7, longs > 0 ? str.tostring(100.0 * longWins / longs, "#") + "% (" + str.tostring(longs) + ")" : "n/a", text_color = color.black)
    table.cell(t, 0, 8, "Short WR", text_color = color.black)
    table.cell(t, 1, 8, shorts > 0 ? str.tostring(100.0 * shortWins / shorts, "#") + "% (" + str.tostring(shorts) + ")" : "n/a", text_color = color.black)

// ─── Higher timeframe candle to the right of price (PO3 view) ──────────────
[po3O, po3H, po3L, po3C] = request.security(syminfo.tickerid, po3Tf, [open, high, low, close], lookahead = barmerge.lookahead_on)
var box po3Body = na
var line po3Wick = na
var label po3Label = na
if showPo3 and barstate.islast
    box.delete(po3Body)
    line.delete(po3Wick)
    label.delete(po3Label)
    x1 = bar_index + 4
    x2 = bar_index + 8
    col = po3C >= po3O ? color.new(#26a69a, 40) : color.new(#ef5350, 40)
    po3Body := box.new(x1, math.max(po3O, po3C), x2, math.min(po3O, po3C), border_color = col, bgcolor = col)
    po3Wick := line.new(x1 + 2, po3H, x1 + 2, po3L, color = col, width = 2)
    po3Label := label.new(x2 + 2, po3H, po3Tf + " CANDLE PO3\nRange: " + str.tostring(po3H - po3L, format.mintick) + " " + syminfo.currency,
         style = label.style_label_left, color = color.new(#d1d4dc, 30), textcolor = color.black, size = size.small)
